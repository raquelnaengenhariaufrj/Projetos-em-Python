# ============================================================
# IMPORTAÇÕES
# ============================================================

from datetime import datetime
import random

# ============================================================
# FUNÇÕES AUXILIARES
# ============================================================

def linha():
    """Imprime uma linha separadora."""
    print("-" * 50)


def ler_opcao(mensagem, opcoes_validas):
    """
    Lê a opção do usuário e valida a entrada.
    """
    opcao = input(mensagem).strip()
    while opcao not in opcoes_validas:
        print("Opção inválida. Tente novamente.")
        opcao = input(mensagem).strip()
    return opcao


# ============================================================
# APRESENTAÇÃO DO SISTEMA
# ============================================================

def apresentacao_turinho():
    """
    Apresenta o assistente virtual Turinho e exibe data e hora atuais.
    """
    linha()
    agora = datetime.now()
    print("🌟 Olá! Eu sou o Turinho 🌟")
    print(f"📅 Acesso realizado em: {agora.strftime('%d/%m/%Y às %H:%M:%S')}")
    print("Pronto para te ajudar a se organizar!")
    linha()
    input("Pressione ENTER para continuar")


# ============================================================
# SUBMENU DE USUÁRIOS
# ============================================================

def submenu_usuarios(dados):
    while True:
        linha()
        print("MENU DE USUÁRIOS")
        print("1 - Cadastrar usuário")
        print("2 - Listar usuários")
        print("0 - Voltar")
        escolha = ler_opcao("Escolha: ", ["1", "2", "0"])

        if escolha == "1":
            nome = input("Nome: ")
            email = input("Email: ")
            dados["usuarios"].append({
                "nome": nome,
                "email": email,
                "criado_em": datetime.now().strftime("%d/%m/%Y %H:%M")
            })
            print("Usuário cadastrado com sucesso!")

        elif escolha == "2":
            print("Usuários cadastrados:")
            for u in dados["usuarios"]:
                print(f"- {u['nome']} ({u['email']}) | criado em {u['criado_em']}")

        else:
            break


