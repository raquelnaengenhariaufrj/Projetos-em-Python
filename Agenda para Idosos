# ============================================================
# MENU PRINCIPAL
# ============================================================

def menu_principal(dados):
    frases = [
        "Você está indo muito bem! 🌟",
        "Organizar é um ato de cuidado 💜",
        "Mais um passo rumo à organização!"
    ]

    while True:
        print("\n######## TURINGAGEND ########")
        print("1 - Usuários")
        print("2 - Aniversários")
        print("3 - Medicamentos")
        print("4 - Tarefas")
        print("5 - Notas")
        print("0 - Sair")

        escolha = ler_opcao("Escolha: ", ["1", "2", "3", "4", "5", "0"])

        if escolha == "1":
            submenu_usuarios(dados)
        elif escolha == "2":
            submenu_aniversarios(dados)
        elif escolha == "3":
            submenu_medicamentos(dados)
        elif escolha == "4":
            submenu_tarefas(dados)
        elif escolha == "5":
            submenu_notas(dados)
        else:
            linha()
            print(random.choice(frases))
            print("Sistema encerrado. Até a próxima!")
            break


